{
  "name": "interview-case-files",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "db:init": "wrangler d1 execute interview-case-files --local --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute interview-case-files --remote --file=./schema.sql",
    "db:migrate": "wrangler d1 execute interview-case-files --local --file=./migrations/0001_access_tiers.sql",
    "db:migrate:remote": "wrangler d1 execute interview-case-files --remote --file=./migrations/0001_access_tiers.sql",
    "deploy": "wrangler deploy",
    "coach:length": "node scripts/coach-length.mjs",
    "check:access": "node --experimental-sqlite scripts/access-check.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.114.0"
  }
}
