name = "interview-case-files"
main = "worker/index.js"
compatibility_date = "2026-07-27"

# public/ holds the served site and nothing else.
#
# This must NOT point at the repo root. `wrangler dev` watches the assets
# directory recursively and does not honour `.assetsignore` (or accept any
# ignore list), so a root-level directory puts .wrangler/ inside the watched
# tree — local D1 writes on every request, which retriggers the reload, which
# serves another request. Giving the assets their own directory means the
# watcher only ever sees files a human edits.
[assets]
directory = "./public"
binding = "ASSETS"

# Copy this file to wrangler.toml and paste in your own database id:
#   cp wrangler.toml.example wrangler.toml
#   npx wrangler d1 create interview-case-files
# wrangler.toml itself is gitignored so the id stays out of the repo.
[[d1_databases]]
binding = "DB"
database_name = "interview-case-files"
database_id = "YOUR_D1_DATABASE_ID_HERE"
